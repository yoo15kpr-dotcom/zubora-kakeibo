{
  "name": "zubora-kakeibo",
  "version": "1.0.0",
  "private": true,
  "description": "話し言葉で記録できるズボラ向け家計簿",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "test": "node --test test/*.test.js",
    "postinstall": "node scripts/vendor-ocr.js",
    "vendor:ocr": "node scripts/vendor-ocr.js",
    "build:pages": "node scripts/vendor-ocr.js && rm -rf dist-pages && cp -r public dist-pages && touch dist-pages/.nojekyll",
    "publish:pages": "sh scripts/publish-pages.sh"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@tesseract.js-data/jpn": "^1.0.0",
    "tesseract.js": "^7.0.0",
    "zod": "^4.6.5"
  }
}
