{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci",
  "buildCommand": "npm run vendor:ocr",
  "outputDirectory": "public",
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/vendor/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    }
  ],
  "git": {
    "deploymentEnabled": {
      "gh-pages": false
    }
  },
  "ignoreCommand": "git diff --quiet HEAD^ HEAD -- public package.json package-lock.json vercel.json scripts || exit 1"
}
